{
  "$schema": "https://swc.rs/schema.json",
  "sourceMaps": true,  
  "jsc": {
    "minify": {},
    
    "parser": {
      "test": ".*\\.ts$", 
      "syntax": "typescript",
      "tsx": true,
      "decorators": true,
      "dynamicImport": true
    },
    "transform": {
      "legacyDecorator": true,
      "decoratorMetadata": true
    },
    "target": "es2022",
    "loose": false,
    "externalHelpers": true
  },
  "module": {
    "type": "es6"
  }
}
